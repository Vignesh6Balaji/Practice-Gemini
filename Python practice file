Master Project: Automated Content Logger (Multithreading & Error Handling)

class VideoIdea:
    def __init__(self, topic):
        self.topic = topic

    def log_idea(self):
        with open("content_calendar.txt", "a") as file:
            file.write(self.topic + "\n")

try:
    content = input("What is the new video topic? ")
    
    if content == "":
        raise ValueError("Topic cannot be empty!")
    else:
        new_video = VideoIdea(content)
        new_video.log_idea()
        print("Topic saved successfully!")

except ValueError as e:
    print("Error: " + str(e))
